# ---- .gitignore para proyecto Vite + React + TypeScript (con Tailwind) ----
# Dependencias
node_modules/
.npm/
.pnpm-store/

# Build de Vite
dist/

# Cobertura de tests
coverage/
.nyc_output/

# Caches/artefactos de herramientas
.eslintcache
.stylelintcache
.cache
*.tsbuildinfo

# Variables de entorno (solo versioná un .env.example)
.env
.env.*
!.env.example

# Vercel (metadatos locales)
.vercel/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos del SO/editores
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
.history/
*.swp
*~

# Opcionales (descomentar si aplica)
# screenshots/
# .turbo/
